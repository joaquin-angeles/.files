#!/usr/bin/env dash
export XDG_CURRENT_DESKTOP=river

# Portal fixes
dbus-update-activation-environment --systemd \
XDG_CURRENT_DESKTOP XDG_SESSION_TYPE WAYLAND_DISPLAY
systemctl --user import-environment \
XDG_CURRENT_DESKTOP XDG_SESSION_TYPE WAYLAND_DISPLAY

# Output & layout
riverctl rule-add ssd
riverctl default-layout rivertile
riverctl spawn 'rivertile \
-main-ratio 0.55 \
-view-padding 5 \
-outer-padding 5'

# Startup
riverctl spawn 'waybar'
riverctl spawn 'wbg ~/Pictures/Wallpapers/gruvbox/trees.png'
riverctl spawn "$HOME/.local/bin/power-saver.sh"
riverctl spawn 'swayosd-server'
riverctl spawn 'mako'
riverctl spawn 'foot --server'
riverctl spawn 'sh -c "rm -f ~/.cache/cliphist/db && cliphist.sh"'
riverctl spawn 'sh -c "[ -f /sys/class/backlight/*/brightness ] || brightnessctl set 50%"'

# Modifier key
mod="Super"

# App shortcuts
browser='sh -c "zen || flatpak run app.zen_browser.zen"'
filemanager='foot -e yazi'
menu='rofi -show drun'
term='footclient'
riverctl map normal "$mod" Return spawn "$term"
riverctl map normal "$mod" Space spawn "$menu"
riverctl map normal "$mod" B spawn "$browser"
riverctl map normal "$mod" E spawn "$filemanager"
riverctl map normal "$mod+Shift" E spawn 'thunar'
riverctl map normal "$mod" Period spawn 'rofi -show emoji'
riverctl map normal "$mod" V spawn 'sh -c "cliphist list | rofi -dmenu -p clipboard | cliphist decode | wl-copy"'

# Screenshots
riverctl map normal "$mod" S spawn 'grim - | wl-copy && notify-send "Screenshot saved" "Image copied to clipboard"'
riverctl map normal "$mod+Shift" S spawn 'sh -c "wayfreeze & sleep 0.1 && grim -g \"$(slurp)\" - | wl-copy; pkill wayfreeze; notify-send \"Screenshot saved\" \"Image copied to clipboard\""'

# Toggles
riverctl map normal "$mod" W spawn 'sh -c "pgrep waybar >/dev/null && pkill waybar || waybar &"'
riverctl map normal "$mod" N spawn 'sh -c "if makoctl mode | grep -q do-not-disturb; then makoctl mode -r do-not-disturb && notify-send \"DND Off\" \"Notifications enabled\"; else notify-send \"DND On\" \"Notifications silenced\" && makoctl mode -a do-not-disturb; fi"'
riverctl map normal Control+Alt B spawn 'sh -c "pgrep sunsetr >/dev/null && pkill sunsetr || sunsetr test 4000 100"'

# Misc
riverctl map normal "$mod+Shift" Q spawn 'power-menu.sh'
riverctl map normal "$mod+Shift" P spawn 'hyprpicker -a'
riverctl map normal "$mod+Shift" Space spawn 'sh -c "cheatsheet.sh | rofi -dmenu -p keybinds"'

# Volume & brightness (Super+Fn)
riverctl map normal "$mod" F9 spawn 'swayosd-client --brightness lower'
riverctl map normal "$mod" F10 spawn 'swayosd-client --brightness raise'
riverctl map normal "$mod" F11 spawn 'swayosd-client --output-volume lower'
riverctl map normal "$mod" F12 spawn 'swayosd-client --output-volume raise'
riverctl map normal "$mod+Shift" F12 spawn 'swayosd-client --output-volume mute-toggle'

# Media keys
riverctl map normal None XF86AudioLowerVolume spawn 'swayosd-client --output-volume lower'
riverctl map normal None XF86AudioRaiseVolume spawn 'swayosd-client --output-volume raise'
riverctl map normal None XF86AudioMute spawn 'swayosd-client --output-volume mute-toggle'

# Brightness keys
riverctl map normal None XF86MonBrightnessUp spawn 'swayosd-client --brightness raise'
riverctl map normal None XF86MonBrightnessDown spawn 'swayosd-client --brightness lower'

# Window management
riverctl map normal "$mod" Q close
riverctl map normal "$mod" F toggle-fullscreen
riverctl map normal "$mod+Shift" F toggle-float

# Focus (hjkl)
riverctl map normal "$mod" H focus-view left
riverctl map normal "$mod" J focus-view down
riverctl map normal "$mod" K focus-view up
riverctl map normal "$mod" L focus-view right

# Swap (Shift+hjkl)
riverctl map normal "$mod+Shift" H swap left
riverctl map normal "$mod+Shift" J swap down
riverctl map normal "$mod+Shift" K swap up
riverctl map normal "$mod+Shift" L swap right

# Resize (Alt+hjkl)
riverctl map normal "$mod+Alt" H send-layout-cmd rivertile 'main-ratio -0.025'
riverctl map normal "$mod+Alt" J send-layout-cmd rivertile 'main-count -1'
riverctl map normal "$mod+Alt" K send-layout-cmd rivertile 'main-count +1'
riverctl map normal "$mod+Alt" L send-layout-cmd rivertile 'main-ratio +0.025'

# Mouse
riverctl map-pointer normal "$mod" BTN_LEFT move-view
riverctl map-pointer normal "$mod" BTN_RIGHT resize-view

# Tags (workspaces)
i=1
while [ "$i" -le 9 ]; do
    tags=$(( 1 << (i - 1) ))
    riverctl map normal "$mod" "$i" set-focused-tags "$tags"
    riverctl map normal "$mod+Shift" "$i" set-view-tags "$tags"
    i=$(( i + 1 ))
done
all_tags=$(( (1 << 32) - 1 ))
riverctl map normal "$mod" 0 set-focused-tags "$all_tags"
riverctl map normal "$mod+Shift" 0 set-view-tags "$all_tags"

# Borders
riverctl border-width 2
riverctl border-color-focused 0x56595a80
riverctl border-color-unfocused 0x56595a40

# Input
riverctl keyboard-layout -options 'caps:escape' ''

# Pointer configuration
riverctl xcursor-theme Bibata-Modern-Ice 24
riverctl set-cursor-warp on-output-change
riverctl focus-follows-cursor normal
riverctl hide-cursor timeout 5000
riverctl hide-cursor when-typing enabled
riverctl list-inputs 2>/dev/null | while IFS= read -r input; do
    case "$input" in
        *[Tt]ouchpad*)
            riverctl input "$input" accel-profile adaptive
            riverctl input "$input" pointer-accel 0.3
            riverctl input "$input" natural-scroll enabled
            ;;
        *)
            riverctl input "$input" accel-profile flat
            ;;
    esac
done
