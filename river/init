#!/usr/bin/env dash
export XDG_CURRENT_DESKTOP=river

# Portal fixes
dbus-update-activation-environment --systemd \
    XDG_CURRENT_DESKTOP XDG_SESSION_TYPE WAYLAND_DISPLAY
systemctl --user import-environment \
    XDG_CURRENT_DESKTOP XDG_SESSION_TYPE WAYLAND_DISPLAY

# Output & layout
riverctl rule-add ssd
riverctl default-layout wideriver
riverctl spawn 'wideriver \
--border-width 2 \
--border-color-focused 0x648b82cc \
--border-color-unfocused 0x56595a80 \
--layout left \
--stack even \
--ratio-master 0.55 \
--inner-gaps 10 \
--outer-gaps 10 \
--smart-gaps \
--border-width-smart-gaps 0'

# Input
riverctl keyboard-layout -options 'caps:escape' ''
riverctl xcursor-theme Bibata-Modern-Ice 24
riverctl set-cursor-warp on-output-change
riverctl focus-follows-cursor disabled
riverctl hide-cursor timeout 5000
riverctl hide-cursor when-typing disabled
riverctl spawn 'river-input'

# Startup
riverctl spawn 'waybar'
riverctl spawn 'wbg ~/Pictures/Wallpapers/trees.png'
riverctl spawn 'wlr-power'
riverctl spawn 'mako'
riverctl spawn 'foot --server'
riverctl spawn 'cliphist.sh'
riverctl spawn 'idle.sh'

mod="Super"

# Window management
riverctl map normal "$mod+Shift" Q        close
riverctl map normal "$mod"       F        toggle-fullscreen
riverctl map normal "$mod+Shift" Space    toggle-float

# Focus (hjkl)
riverctl map normal "$mod" H focus-view left
riverctl map normal "$mod" J focus-view down
riverctl map normal "$mod" K focus-view up
riverctl map normal "$mod" L focus-view right

# Swap (Shift+hjkl)
riverctl map normal "$mod+Shift" H swap left
riverctl map normal "$mod+Shift" J swap down
riverctl map normal "$mod+Shift" K swap up
riverctl map normal "$mod+Shift" L swap right

# Resize (Alt+hjkl)
riverctl map normal "$mod+Alt" H send-layout-cmd wideriver '--ratio -0.05'
riverctl map normal "$mod+Alt" J send-layout-cmd wideriver '--count -1'
riverctl map normal "$mod+Alt" K send-layout-cmd wideriver '--count +1'
riverctl map normal "$mod+Alt" L send-layout-cmd wideriver '--ratio +0.05'

# Mouse
riverctl map-pointer normal "$mod" BTN_LEFT  move-view
riverctl map-pointer normal "$mod" BTN_RIGHT resize-view

# Tags (workspaces)
riverctl map normal "$mod"        "$i" set-focused-tags "$tags"
riverctl map normal "$mod+Shift"  "$i" set-view-tags "$tags"

# Apps
riverctl map normal "$mod"        Return spawn 'footclient'
riverctl map normal "$mod"        D      spawn 'tofi-drun'
riverctl map normal "$mod"        B      spawn 'sh -c "librewolf || flatpak run io.gitlab.librewolf-community"'
riverctl map normal "$mod"        E      spawn 'pcmanfm'
riverctl map normal "$mod+Shift"  E      spawn 'rofi -show emoji'
riverctl map normal "$mod+Shift"  V      spawn 'sh -c "cliphist list | rofi -dmenu -p clipboard | cliphist decode | wl-copy"'

# Screenshots
riverctl map normal "$mod+Shift"  S spawn 'grim - | wl-copy && notify-send "Screenshot saved" "Image copied to clipboard"'
riverctl map normal "$mod"        S spawn 'region-capture.sh && notify-send "Screenshot saved" "Image copied to clipboard"'
riverctl map normal "$mod+Shift"  C spawn 'hyprpicker -a'

# Toggles
riverctl map normal "$mod+Shift"  B spawn 'sh -c "pgrep waybar >/dev/null && pkill waybar || waybar &"'
riverctl map normal "$mod+Shift"  N spawn 'sh -c "pgrep sunsetr >/dev/null && pkill sunsetr || sunsetr test 4000 100"'

# Misc
riverctl map normal "$mod+Shift"  P  spawn 'rofi-power-menu'
riverctl map normal "$mod"        F1 spawn 'sh -c "river-sheet | rofi -dmenu -p keybinds"'

# Volume & brightness
riverctl map normal "$mod"        Down  spawn 'osd.sh volume_down'
riverctl map normal "$mod"        Up    spawn 'osd.sh volume_up'
riverctl map normal "$mod"        Left  spawn 'osd.sh brightness_down'
riverctl map normal "$mod"        Right spawn 'osd.sh brightness_up'
riverctl map normal "$mod+Shift"  M     spawn 'osd.sh volume_mute'

# Media keys
riverctl map normal None XF86AudioLowerVolume  spawn 'osd.sh volume_down'
riverctl map normal None XF86AudioRaiseVolume  spawn 'osd.sh volume_up'
riverctl map normal None XF86AudioMute         spawn 'osd.sh volume_mute'
riverctl map normal None XF86MonBrightnessUp   spawn 'osd.sh brightness_up'
riverctl map normal None XF86MonBrightnessDown spawn 'osd.sh brightness_down'
