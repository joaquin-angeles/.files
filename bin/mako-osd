#!/usr/bin/env dash
# mako-osd : volume/brightness notifier for mako

# Config
VOLUME_STEP=5
BRIGHTNESS_STEP=5
MAX_VOLUME=100
NOTIFICATION_TIME=2000

# Draw a simple bar
bar() {
    awk -v v="$1" '
    BEGIN {
    n = 10
    filled = int(v * n / 100)

    for (i = 0; i < filled; i++) filled_bar = filled_bar "▬"
    for (i = filled; i < n; i++) empty_bar = empty_bar "▬"

    print filled_bar "<span foreground=\"#56595a\">" empty_bar "</span>"
    }'
}

# Send notification
osd() {
    notify-send \
        --app-name=osd \
        --urgency=low \
        --expire-time="$NOTIFICATION_TIME" \
        --hint=int:x-mako-width:225 \
        --hint="string:x-canonical-private-synchronous:$1" \
        "$2" \
        "$3"
}

# Volume notification
vol_notif() {
    local vol_raw vol

    vol_raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
    vol=$(echo "$vol_raw" | awk '{printf "%d", $2 * 100}')

    if echo "$vol_raw" | grep -q '\[MUTED\]'; then
        indicator="(muted)"
    fi

    osd osd-volume "Volume $indicator" "$(bar "$vol")  ${vol}%"
}

# Brightness notification
bri_notif() {
    local bri

    bri=$(brightnessctl -m | awk -F, '{gsub(/%/,"",$4); print $4}')
    osd osd-brightness "Brightness" "$(bar "$bri")  ${bri}%"
}

# Commands
case "$1" in
    volume_up)
        current=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2 * 100}')

        if [ $((current + VOLUME_STEP)) -gt "$MAX_VOLUME" ]; then
            wpctl set-volume @DEFAULT_AUDIO_SINK@ "${MAX_VOLUME}%"
        else
            wpctl set-volume @DEFAULT_AUDIO_SINK@ "${VOLUME_STEP}%+"
        fi

        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
        vol_notif
        ;;

    volume_down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "${VOLUME_STEP}%-"
        vol_notif
        ;;

    volume_mute)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        vol_notif
        ;;

    brightness_up)
        brightnessctl set "${BRIGHTNESS_STEP}%+"
        bri_notif
        ;;

    brightness_down)
        brightnessctl set "${BRIGHTNESS_STEP}%-"
        bri_notif
        ;;

    *)
        echo "Usage: $0 <volume_up|volume_down|volume_mute|brightness_up|brightness_down>"
        exit 1
        ;;
esac
