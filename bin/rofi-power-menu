#!/usr/bin/env dash

confirm() {
    confirmed=$(printf 'Yes\nNo' | rofi -dmenu \
            -p "$(printf '󰐥 %s?' "$1")" \
            -lines 2 \
            -selected-row 1 \
        -no-custom)

    [ $? -ne 0 ] && return 1
    [ "$confirmed" = "Yes" ] && return 0 || return 1
}

options="󰐥 Shutdown
󰜉 Reboot
󰌾 Lock
󰤄 Suspend
󰍃 Logout"

choice="$(printf '%s\n' "$options" | rofi -dmenu -p "power")"

[ $? -ne 0 ] && exit 0

case "$choice" in
    "󰐥 Shutdown")
        confirm "Shutdown" && systemctl poweroff
        ;;
    "󰜉 Reboot")
        confirm "Reboot" && systemctl reboot
        ;;
    "󰌾 Lock")
        # Lock doesn't need confirmation — it's reversible
        if command -v gtklock >/dev/null 2>&1; then
            gtklock
        elif command -v hyprlock >/dev/null 2>&1; then
            hyprlock
        elif command -v i3lock >/dev/null 2>&1; then
            i3lock
        elif command -v betterlockscreen >/dev/null 2>&1; then
            betterlockscreen -l
        else
            notify-send "No lock utility found."
        fi
        ;;
    "󰤄 Suspend")
        confirm "Suspend" && systemctl suspend
        ;;
    "󰍃 Logout")
        confirm "Logout" && {
            riverctl exit 2>/dev/null ||
            hyprctl dispatch exit 2>/dev/null ||
            pkill -u "$USER"
        }
        ;;
esac
