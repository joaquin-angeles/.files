#!/usr/bin/env dash

confirm() {
    confirmed=$(printf 'Yes\nNo' | rofi -no-show-icons -dmenu \
            -p "$(printf '%s  %s?' "$2" "$1")" \
            -lines 2 \
            -selected-row 1 \
        -no-custom)

    [ $? -ne 0 ] && return 1
    [ "$confirmed" = "Yes" ] && return 0 || return 1
}

options="󰐥  Shutdown
󰜉  Reboot
󰌾  Lock
󰤄  Suspend
󰍃  Logout"

choice="$(printf '%s\n' "$options" | rofi -no-show-icons -dmenu -p "󰍜")"

[ $? -ne 0 ] && exit 0

icon="${choice%% *}"

case "$choice" in
    "󰐥  Shutdown")
        confirm "Shutdown" "$icon" && systemctl poweroff
        ;;
    "󰜉  Reboot")
        confirm "Reboot" "$icon" && systemctl reboot
        ;;
    "󰌾  Lock")
        loginctl lock-session
        ;;
    "󰤄  Suspend")
        confirm "Suspend" "$icon" && systemctl suspend
        ;;
    "󰍃  Logout")
        confirm "Logout" "$icon" && {
            pkill -u "$USER"
        }
        ;;
esac
