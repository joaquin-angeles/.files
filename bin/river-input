#!/usr/bin/env dash

debounce_pid=
LOG=/tmp/input-config.log
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG" >&2; }

apply() {
    riverctl list-inputs 2>/dev/null | while IFS= read -r dev; do
        case "$dev" in
            *[Tt]ouchpad*)
                riverctl input "$dev" accel-profile adaptive
                riverctl input "$dev" pointer-accel 0.3
                riverctl input "$dev" natural-scroll enabled
                ;;
            *)  riverctl input "$dev" accel-profile flat ;;
        esac
    done
    log "Applied"
}

log "Started" && apply

fifo=$(mktemp -u /tmp/udev-events.XXXXXX)
mkfifo "$fifo"
trap 'rm -f "$fifo"' EXIT INT TERM

udevadm monitor --udev --subsystem-match=usb 2>/dev/null > "$fifo" &

while IFS= read -r line; do
    case "$line" in
        *add*|*remove*)
            kill "$debounce_pid" 2>/dev/null
            { sleep 0.5 && apply; } &
            debounce_pid=$!
            ;;
    esac
done < "$fifo"
