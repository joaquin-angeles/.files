#!/usr/bin/env dash

# Helpers

image() {
    local file="$1" cols="$2" rows="$3"
    local geometry="$(( (cols - 2) * 75 / 100 ))x$(( rows * 75 / 100 ))"
    chafa "$file" -f sixel -s "$geometry" --animate false
}

# Use bat if available, otherwise cat
batorcat() {
    if command -v bat >/dev/null 2>&1; then
        bat --style=plain --color=always "$@"
    else
        cat "$1"
    fi
}

# Display a cached thumbnail, generating it first if missing
cached_image() {
    [ ! -f "$2" ] && "$@" 2>/dev/null
    image "$2" "$W" "$H"
}

# Setup

# Cache path is derived from the file's metadata
CACHE="$HOME/.cache/lf/thumbnail.$(
    stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" \
        | sha256sum \
        | awk '{print $1}'
)"

FILE="$(readlink -f "$1" | awk '{print tolower($0)}')"
W="$2"
H="$3"

# Preview

case "$FILE" in

        # Archives
    *.tgz|*.tar.gz) tar tzf "$1" ;;
    *.tar.bz2|*.tbz2) tar tjf "$1" ;;
    *.tar.txz|*.txz) xz --list "$1" ;;
    *.tar) tar tf "$1" ;;
    *.zip|*.jar|*.war|*.ear) unzip -l "$1" ;;
    *.rar) unrar l "$1" ;;
    *.7z) 7z l "$1" ;;

        # Documents
    *.md)
        command -v glow >/dev/null 2>&1 && glow "$1" || mdcat "$1"
        ;;
    *.odt|*.ods|*.odp|*.sxw) odt2txt "$1" ;;
    *.doc) catdoc "$1" ;;
    *.docx) docx2txt "$1" ;;
    *.xml|*.html) w3m -dump "$1" ;;
    *.xls|*.xlsx)
        ssconvert --export-type=Gnumeric_stf:stf_csv "$1" "fd://1" \
            | batorcat --language=csv
        ;;
    *.[1-8]) man "$1" | col -b ;;

        # Audio
        *.wav|*.mp3|*.flac|*.m4a|*.wma|*.ape|*.ac3|\
        *.og[agx]|*.spx|*.opus|*.as[fx]|*.mka)
        exiftool "$1"
        ;;
    *.torrent) transmission-show "$1" ;;
    *.iso) iso-info --no-header -l "$1" ;;
    *.o) nm "$1" ;;
    *.ino) batorcat --language=cpp "$1" ;;

        # Cached thumbnails
    *.pdf)
        cached_image pdftoppm -jpeg -f 1 -singlefile "$1" "$CACHE" "${CACHE}.jpg"
        ;;
    *.epub)
        cached_image epub-thumbnailer "$1" "$CACHE" 1024 "$CACHE"
        ;;
    *.cbz|*.cbr|*.cbt)
        cached_image comicthumb "$1" "$CACHE" 1024 "$CACHE"
        ;;
    *.svg)
        cached_image convert "$1" "${CACHE}.jpg" "${CACHE}.jpg"
        ;;
        *.avi|*.mp4|*.wmv|*.dat|*.3gp|*.ogv|*.mkv|*.mpg|*.mpeg|*.vob|\
        *.fl[icv]|*.m2v|*.mov|*.webm|*.ts|*.mts|*.m4v|*.r[am]|*.qt|*.divx)
        cached_image ffmpegthumbnailer -i "$1" -o "${CACHE}.jpg" -s 0 -q 5 "${CACHE}.jpg"
        ;;

        # Images
    *.bmp|*.jpg|*.jpeg|*.png|*.xpm|*.webp|*.tiff|*.gif|*.jfif|*.ico)
        image "$1" "$W" "$H"
        ;;

        # Fallback: check MIME type
    *)
        mime="$(file --mime-type -bL "$1")"
        case "$mime" in
            application/x-executable|application/x-sharedlib)
                nm "$1" 2>/dev/null || file "$1"
                ;;
            text/*|application/json|application/x-shellscript)
                batorcat "$1"
                ;;
            *)
                file "$1"
                ;;
        esac
        ;;

esac
